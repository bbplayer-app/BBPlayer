{
	"name": "bbplayer-root",
	"private": true,
	"workspaces": [
		"apps/*",
		"apps/*/web",
		"packages/*",
		"packages/*/example"
	],
	"scripts": {
		"check:deps": "syncpack list-mismatches",
		"fix:deps": "syncpack fix-mismatches",
		"format": "oxfmt --write .",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"postinstall": "lefthook install",
		"publish:update": "pnpm --filter @bbplayer/update-publisher start",
		"type-check": "tsgo --build --noEmit"
	},
	"devDependencies": {
		"@bbplayer/eslint-plugin": "workspace:*",
		"@dword-design/eslint-plugin-import-alias": "^6.0.3",
		"@tanstack/eslint-plugin-query": "^5.101.4",
		"@types/node": "^25.2.3",
		"@typescript/native-preview": "beta",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "19.1.0-rc.1",
		"eslint-plugin-react-hooks-extra": "^1.53.1",
		"eslint-plugin-react-you-might-not-need-an-effect": "^0.5.6",
		"gifenc": "^1.0.3",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"syncpack": "^13.0.4",
		"typescript": "~6.0.3"
	}
}
