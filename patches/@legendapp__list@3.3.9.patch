# 用途：修复本项目提交 b484b5a4 之后出现的歌单分页停在首批 15 条、延迟或无法继续加载的问题。
# 原因：LegendList 即使没有配置某一端的回调，也会关闭两端共用的触发开关，阻塞另一端分页。
# 修复：只有配置了对应回调，才执行该方向的触发判定；位置状态更新和双向回调的原有规则保持不变。
# 过程：https://chatgpt.com/s/cx_6aad5e8f89348191ac2d09fdfba6bdaa

diff --git a/react-native.js b/react-native.js
index aa3209b6e39948172fdc92d1c7c197c1cb05b451..4dc4d30a42b9ae587d61bd903e95110df10b9cc6 100644
--- a/react-native.js
+++ b/react-native.js
@@ -752,7 +752,7 @@ function checkAtBottom(ctx, allowedEdge, allowGateCreatedInCurrentCheck) {
       isContentLess || distanceFromEnd <= maintainScrollAtEndThreshold * scrollLength || state.pendingMaintainScrollAtEnd || maintainingScrollAtEnd === "animated" || maintainingScrollAtEnd === "instant"
     );
     const shouldSkipThresholdChecks = hasActiveInitialScroll(state) || maintainingScrollAtEnd;
-    if (!shouldSkipThresholdChecks) {
+    if (!shouldSkipThresholdChecks && state.props.onEndReached) {
       state.isEndReached = checkThreshold(
         distanceFromEnd,
         isContentLess,
@@ -803,7 +803,7 @@ function checkAtTop(ctx, allowedEdge, allowGateCreatedInCurrentCheck) {
   set$(ctx, "isAtStart", scroll <= EDGE_POSITION_EPSILON);
   set$(ctx, "isNearStart", scroll <= threshold);
   const shouldSkipThresholdChecks = hasActiveInitialScroll(state) || !!state.scrollingTo;
-  if (!shouldSkipThresholdChecks) {
+  if (!shouldSkipThresholdChecks && state.props.onStartReached) {
     state.isStartReached = checkThreshold(
       scroll,
       false,
