{
	"name": "@bottom-tabs/react-navigation",
	"version": "1.2.0",
	"description": "React Native Bottom Tabs React Navigation integration",
	"keywords": [
		"android",
		"expo-router",
		"ios",
		"react-native",
		"react-navigation"
	],
	"homepage": "https://github.com/callstack/react-native-bottom-tabs#readme",
	"bugs": {
		"url": "https://github.com/callstack/react-native-bottom-tabs/issues"
	},
	"license": "MIT",
	"author": "Oskar Kwasniewski <oskarkwasniewski@icloud.com> (https://github.com/okwasniewski)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/callstack/react-native-bottom-tabs.git"
	},
	"source": "./src/index.tsx",
	"files": [
		"src",
		"!**/__tests__",
		"!**/__fixtures__",
		"!**/__mocks__",
		"!**/.*"
	],
	"sideEffects": false,
	"main": "./src/index.tsx",
	"module": "./src/index.tsx",
	"types": "./src/index.tsx",
	"exports": {
		".": {
			"types": "./src/index.tsx",
			"source": "./src/index.tsx",
			"default": "./src/index.tsx"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsc -b --noEmit",
		"lint": "eslint \"**/*.{js,ts,tsx}\"",
		"test": "jest",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"color": "^5.0.3"
	},
	"devDependencies": {
		"@react-navigation/native": "^7.2.2",
		"@types/color": "^4.2.1",
		"jest": "^30.2.0",
		"react": "19.2.3",
		"react-native": "0.85.3",
		"react-native-bottom-tabs": "workspace:*",
		"typescript": "~6.0.3"
	},
	"peerDependencies": {
		"@react-navigation/native": ">=7",
		"react": "*",
		"react-native": "*",
		"react-native-bottom-tabs": "*"
	},
	"jest": {
		"modulePathIgnorePatterns": [
			"<rootDir>/example/node_modules",
			"<rootDir>/lib/"
		],
		"preset": "react-native"
	}
}
