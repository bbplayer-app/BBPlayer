{
	"languages": {
		"JavaScript": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["!eslint", "..."]
		},
		"TypeScript": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["typescript-ls", "!vtsls", "!eslint", "..."]
		},
		"TSX": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["typescript-ls", "!vtsls", "!eslint", "..."]
		},
		"JSON": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		}
	},
	"lsp": {
		"typescript-ls": {
			"binary": {
				"path": "node_modules/.bin/tsrs",
				"arguments": ["--lsp", "--stdio"]
			}
		}
	}
}
