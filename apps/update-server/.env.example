# PostgreSQL. The migration command needs only this variable.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://updates:replace-with-a-long-random-password@postgres:5432/updates?sslmode=disable

# Cloudflare R2 S3 API credentials. Never use a Cloudflare API token here:
# create an R2 API token with Object Read & Write scoped to this bucket.
R2_BUCKET=bbplayer-updates
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional override used only for local MinIO-compatible integration tests.
R2_ENDPOINT=
# Public custom domain bound to this bucket, without a trailing slash.
R2_PUBLIC_BASE_URL=https://updates-assets.example.com

# Public Go API URL, without a trailing slash.
PUBLIC_BASE_URL=https://updates-api.example.com
# Long random independent secrets. Do not reuse either one.
ADMIN_TOKEN=replace-with-a-long-random-token
INSTALLATION_HMAC_KEY=replace-with-at-least-32-random-bytes

# Optional until code signing is enabled in the mobile build.
CODE_SIGNING_PRIVATE_KEY=
CODE_SIGNING_KEY_ID=
