---
import {
	ArrowRight,
	ArrowUpRight,
	Captions,
	CloudUpload,
	Download,
	Gauge,
	Import,
	Link,
	MessageSquareText,
	Share2,
	Shirt,
	TabletSmartphone,
	UserCheck,
	Users,
} from '@lucide/astro'
import { Image } from 'astro:assets'

import GithubIcon from '../components/GithubIcon.astro'
import icon from '../assets/icon.png'
import library from '../assets/landing/library.webp'
import podcastPlayer from '../assets/landing/podcast_player.webp'
import podcastSubtitles from '../assets/landing/podcast_subtitles.webp'
import profile from '../assets/landing/profile.webp'
import songLyrics from '../assets/landing/song_lyrics.webp'
import songPlayer from '../assets/landing/song_player.webp'
import songPlayerSpectrum from '../assets/landing/song_player_spectrum.webp'
import '../styles/landing.css'

const REPO = 'https://github.com/bbplayer-app/BBPlayer'
const RELEASES = `${REPO}/releases/latest`

const features = [
	{
		index: '01',
		label: 'Lyrics',
		title: '逐字歌词，唱到哪亮到哪',
		body: '从网易云音乐、QQ 音乐和酷狗自动匹配歌词，逐字进度、翻译与罗马音一起显示。对不上的时候，可以按 0.5 秒微调时间轴，或者直接动手编辑。',
		points: ['歌词源可选网易云 / QQ 音乐 / 酷狗', '逐字 · 翻译 · 罗马音', '手动搜索、编辑与时间轴偏移'],
		image: songLyrics,
		alt: 'BBPlayer 深色歌词页，逐字高亮正在演唱的日文歌词，下方显示中文翻译',
		href: '/guides/lyrics/',
	},
	{
		index: '02',
		label: 'Player',
		title: '每首歌，都有自己的颜色',
		body: '播放器从封面提取主题色，背景是缓慢流动的着色器渐变，进度条随播放轻轻起伏。想要更多反馈，还可以在封面周围打开实时音频频谱。',
		points: ['封面取色与流体背景', '波浪进度条与音频频谱', '悬浮 / 沉浸两种播放条样式'],
		image: songPlayer,
		alt: 'BBPlayer 深色播放器，蓝色流体背景、圆形封面与波浪进度条',
		href: '/guides/player/',
	},
	{
		index: '03',
		label: 'Library',
		title: '各处的收藏，收进同一个库',
		body: 'B 站收藏夹、订阅合集、稍后再看、关注的 UP 主投稿和多 P 视频，都能直接打开浏览和播放。值得留下的一键同步成本地歌单，下载后离线也能听；之后改名、拖动排序、批量整理都随你，还能反向同步到 B 站。',
		points: ['收藏夹 · 合集 · 稍后再看 · UP 主投稿', '一键同步到本地，下载后离线播放', '拖动排序、批量管理，可同步回 B 站'],
		image: library,
		alt: 'BBPlayer 音乐库，列出日常循环、中文 VOCALOID、Girls Band Cry 等本地歌单',
		href: '/guides/playlist/',
	},
	{
		index: '04',
		label: 'Records',
		title: '听过的，都记得',
		body: '每一次完整播放都记在你的设备上。累计时长、播放次数和按天排列的热力图就在「我的」页最上方，点开日期能回看那天听了什么，「全部统计」里还有你的播放排行。',
		points: ['听歌热力图与每日历史', '累计时长与完整播放次数', '记录只保存在本地'],
		image: profile,
		alt: 'BBPlayer「我的」页面，显示累计听歌时长、完整播放次数与按周排列的听歌热力图',
		href: '/guides/leaderboard/',
	},
]

const duos = [
	{
		index: '05',
		label: 'Podcast',
		title: '播客，也一样好用',
		sub: '访谈、课程、长视频。切到播客模式，播放器会换成更适合长内容的一套控制。',
		link: { href: '/guides/podcast/', text: '了解播客模式' },
		items: [
			{
				image: podcastPlayer,
				alt: 'BBPlayer 播客播放器，显示章节名、快退快进 15 秒、倍速、定时与章节入口',
				title: '记住每一期听到哪',
				body: '每段音频单独保存进度，再次打开从上次的位置继续。倍速、定时关闭、章节列表都在手边，进度条上方显示当前章节。',
			},
			{
				image: podcastSubtitles,
				alt: 'BBPlayer 播客字幕页，按时间分段显示 B 站字幕并高亮当前句子',
				title: '跟着字幕读',
				body: 'B 站字幕随播放自动定位并高亮当前句子。可以搜索关键词、点句子跳转，或者把整份字幕导出成 LRC。',
			},
		],
	},
]

const details = [
	{ icon: Captions, title: '系统级歌词', body: '桌面悬浮歌词、状态栏歌词（词幕、SuperLyric、Flyme），车机上也能看到当前歌词。', href: '/guides/lyrics/#desktop-lyrics' },
	{ icon: Shirt, title: 'B 站装扮', body: '搜索并下载 B 站主题装扮与收藏集，换上对应的标题栏、进度滑块、点赞动画、头像框和开屏动画。', href: '/guides/settings/#skins' },
	{ icon: MessageSquareText, title: '评论区', body: '在播放器里浏览当前视频的评论和回复，不用切回 B 站。', href: '/guides/comments/' },
	{ icon: UserCheck, title: '关注的 UP 主', body: '浏览关注列表，直接收听他们的投稿，不用再一个个翻主页。', href: '/guides/playlist/' },
	{ icon: Import, title: '导入外部歌单', body: '粘贴网易云或 QQ 音乐歌单链接，自动在 B 站匹配对应曲目。', href: '/guides/external-playlist/' },
	{ icon: Link, title: '链接直达', body: 'BV / AV 号、b23.tv 短链和完整视频链接，粘贴进搜索框就能播放。', href: '/guides/search/' },
	{ icon: Download, title: '离线与导出', body: '整个歌单一键缓存；Android 可导出带封面和歌词的 m4a 文件。', href: '/guides/download/' },
	{ icon: Share2, title: '分享卡片', body: '用封面主题色生成歌曲卡片或歌词卡片，保存或直接分享。', href: '/guides/player/' },
	{ icon: Users, title: '共享歌单', body: '一条链接邀请朋友订阅或一起编辑，使用独立账号，不碰 B 站 Cookie。', href: '/guides/shared-playlist/' },
	{ icon: Gauge, title: 'CDN 测速', body: '测速并选择首选 Bilibili CDN 节点，加载慢的时候换一个试试。', href: '/guides/settings/' },
	{ icon: CloudUpload, title: '备份与迁移', body: '导出 .bbplayer 备份文件，或者直接备份到自己的 WebDAV。', href: '/guides/settings/' },
	{ icon: TabletSmartphone, title: '平板与大屏', body: '宽屏下切换为侧边导航栏，较大的屏幕上使用双栏布局。', href: '/guides/' },
]

const stack = [
	{ name: '@bbplayer/orpheus', desc: '基于 Media3 / ExoPlayer 的音频引擎，原生处理 B 站音频流，双层缓存', tag: 'Kotlin' },
	{ name: '@bbplayer/splash', desc: 'LRC / SPL 歌词解析，并把 YRC 等格式转换为逐字歌词', tag: 'TypeScript' },
	{ name: '@bbplayer/image-theme-colors', desc: '零拷贝读取 ImageRef，用 Android Palette 提取封面主题色', tag: 'Kotlin' },
	{ name: 'expo-wavy-slider', desc: 'Jetpack Compose 实现的 Material 3 波浪进度条', tag: 'Compose' },
]
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#08090c" />
		<title>BBPlayer · 专心收听的 Bilibili 播放器</title>
		<meta name="description" content="BBPlayer 是一个开源的 Bilibili 音频播放器：逐字歌词、封面取色的流体播放器、桌面与状态栏歌词，以及支持断点续播和字幕跟读的播客模式。" />
		<meta property="og:title" content="BBPlayer · 专心收听的 Bilibili 播放器" />
		<meta property="og:description" content="B 站上想听的，值得一个专门的播放器。逐字歌词、流体播放器、系统级歌词，播客也一样好用。" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://bbplayer.roitium.com/" />
		<link rel="icon" href="/favicon.ico" />
		<script is:inline>document.documentElement.classList.add('js')</script>
	</head>
	<body class="landing">
		<header class="nav">
			<div class="nav-inner">
				<a href="/" class="brand">
					<Image src={icon} alt="" width={28} height={28} class="brand-icon" />
					<span>BBPlayer</span>
				</a>
				<nav class="nav-links" aria-label="主导航">
					<a href="/guides/">指南</a>
					<a href="/SPL/">歌词规范</a>
					<a href={REPO} class="nav-github" aria-label="GitHub">
						<GithubIcon size={16} />
						<span>GitHub</span>
					</a>
				</nav>
				<a href={RELEASES} class="btn btn-sm btn-primary">下载</a>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="hero-grid" aria-hidden="true"></div>
				<div class="hero-glow" aria-hidden="true"></div>

				<div class="container hero-copy">
					<a href={RELEASES} class="pill">
						<span class="pill-dot"></span>
						<span class="mono">v2.8</span>
						<span class="pill-sep"></span>
						<span>播客字幕跟读、更低的后台功耗</span>
						<ArrowRight size={14} />
					</a>
					<h1>
						B 站上想听的，<br />
						值得一个<span class="accent">专门的播放器</span>。
					</h1>
					<p class="lede">
						BBPlayer 把 Bilibili 上的歌和节目都收进一个专心收听的播放器：逐字歌词、随封面流动的界面、桌面与状态栏歌词。听长节目时，它会记住进度、标出章节，还能跟着字幕读。
					</p>
					<div class="cta">
						<a href={RELEASES} class="btn btn-primary">
							<Download size={16} />
							下载 Android 版
						</a>
						<a href="/guides/" class="btn btn-ghost">
							阅读指南
							<ArrowRight size={16} />
						</a>
					</div>
					<p class="meta mono">免费 · 开源 · 无广告 · MIT License</p>
				</div>

				<div class="container hero-stage" data-deck>
					<figure class="shot shot-side shot-left" data-pos="2">
						<Image src={profile} alt="BBPlayer「我的」页面，显示听歌时长、播放次数与听歌热力图" widths={[360, 600]} sizes="(max-width: 720px) 70vw, 270px" loading="eager" />
					</figure>
					<figure class="shot shot-main" data-pos="0">
						<Image src={songPlayerSpectrum} alt="BBPlayer 播放器，圆形封面周围环绕实时音频频谱，下方是波浪进度条" widths={[400, 720]} sizes="(max-width: 720px) 74vw, 320px" loading="eager" fetchpriority="high" />
					</figure>
					<figure class="shot shot-side shot-right" data-pos="1">
						<Image src={songLyrics} alt="BBPlayer 歌词页，逐字高亮的日文歌词与中文翻译" widths={[360, 600]} sizes="(max-width: 720px) 70vw, 270px" loading="eager" />
					</figure>
				</div>
				<div class="deck-nav" aria-label="切换截图">
					<button type="button" class="deck-dot is-active" data-deck-dot="0" aria-label="播放器"></button>
					<button type="button" class="deck-dot" data-deck-dot="1" aria-label="逐字歌词"></button>
					<button type="button" class="deck-dot" data-deck-dot="2" aria-label="我的"></button>
					<span class="deck-hint mono">左右滑动</span>
				</div>
			</section>

			<section class="strip">
				<div class="container strip-grid" data-reveal>
					<div>
						<span class="strip-k mono">LYRICS</span>
						<span class="strip-v">逐字 · 翻译 · 罗马音</span>
					</div>
					<div>
						<span class="strip-k mono">LIBRARY</span>
						<span class="strip-v">收藏夹 · 合集 · 稍后再看</span>
					</div>
					<div>
						<span class="strip-k mono">SYSTEM</span>
						<span class="strip-v">桌面 · 状态栏 · 车载歌词</span>
					</div>
					<div>
						<span class="strip-k mono">PODCAST</span>
						<span class="strip-v">续播 · 章节 · 字幕</span>
					</div>
				</div>
			</section>

			<section class="features" id="features">
				<div class="container">
					{features.map((f, i) => (
						<article class:list={['feature', { 'feature-flip': i % 2 === 1 }]}>
							<div class="feature-copy" data-reveal>
								<p class="eyebrow mono">
									<span>{f.index}</span>
									<span class="eyebrow-line"></span>
									<span>{f.label}</span>
								</p>
								<h2>{f.title}</h2>
								<p class="feature-body">{f.body}</p>
								<ul class="points">
									{f.points.map((p) => <li>{p}</li>)}
								</ul>
								<a href={f.href} class="link">
									了解更多
									<ArrowRight size={14} />
								</a>
							</div>
							<div class="feature-visual">
								<div class="visual-frame" data-reveal style="--delay: 120ms">
									<figure class="shot">
										<Image src={f.image} alt={f.alt} widths={[400, 720]} sizes="(max-width: 720px) 66vw, 300px" />
									</figure>
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			{duos.map((duo) => (
				<section class="duo">
					<div class="container">
						<div class="section-head section-head-center" data-reveal>
							<p class="eyebrow mono">
								<span>{duo.index}</span>
								<span class="eyebrow-line"></span>
								<span>{duo.label}</span>
							</p>
							<h2>{duo.title}</h2>
							<p class="section-sub">{duo.sub}</p>
						</div>
						<div class="duo-grid">
							{duo.items.map((item, i) => (
								<figure class="duo-item" data-reveal style={i > 0 ? '--delay: 120ms' : undefined}>
									<div class="visual-frame">
										<div class="shot">
											<Image src={item.image} alt={item.alt} widths={[400, 720]} sizes="(max-width: 720px) 66vw, 280px" />
										</div>
									</div>
									<figcaption>
										<h3>{item.title}</h3>
										<p>{item.body}</p>
									</figcaption>
								</figure>
							))}
						</div>
						<div class="center-link">
							<a href={duo.link.href} class="link">
								{duo.link.text}
								<ArrowRight size={14} />
							</a>
						</div>
					</div>
				</section>
			))}

			<section class="details">
				<div class="container">
					<div class="section-head" data-reveal>
						<p class="eyebrow mono">
							<span>06</span>
							<span class="eyebrow-line"></span>
							<span>Details</span>
						</p>
						<h2>藏在细节里的部分</h2>
						<p class="section-sub">从找歌、整理到离线和分享，B 站上听歌的每一步都考虑到了。</p>
					</div>
					<div class="bento" data-reveal style="--delay: 80ms">
						{details.map((d) => (
							<a href={d.href} class="cell">
								<d.icon size={18} class="cell-icon" />
								<h3>{d.title}</h3>
								<p>{d.body}</p>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="engine">
				<div class="container engine-grid">
					<div class="engine-copy" data-reveal>
						<p class="eyebrow mono">
							<span>07</span>
							<span class="eyebrow-line"></span>
							<span>Engineering</span>
						</p>
						<h2>不止是一层壳</h2>
						<p class="section-sub">
							播放、歌词和取色都由自己维护的原生模块完成。整个项目是一个 monorepo，代码全部公开，欢迎提交 Issue 或 Pull Request。
						</p>
						<a href={REPO} class="btn btn-ghost">
							<GithubIcon size={16} />
							bbplayer-app/BBPlayer
							<ArrowUpRight size={16} />
						</a>
					</div>
					<div class="terminal" role="list" data-reveal style="--delay: 120ms">
						<div class="terminal-bar" aria-hidden="true">
							<span></span><span></span><span></span>
							<code class="mono">packages/</code>
						</div>
						{stack.map((s) => (
							<div class="pkg" role="listitem">
								<div class="pkg-head">
									<code class="mono">{s.name}</code>
									<span class="pkg-tag mono">{s.tag}</span>
								</div>
								<p>{s.desc}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="final">
				<div class="hero-glow final-glow" aria-hidden="true"></div>
				<div class="container final-inner" data-reveal>
					<Image src={icon} alt="" width={64} height={64} class="final-icon" />
					<h2>安静地听。</h2>
					<p class="section-sub">从 GitHub Releases 下载 APK，大多数设备选择 arm64-v8a。</p>
					<div class="cta">
						<a href={RELEASES} class="btn btn-primary">
							<Download size={16} />
							下载最新版本
						</a>
						<a href="/guides/install/" class="btn btn-ghost">安装说明</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<span>BBPlayer</span>
					<span class="mono dim">MIT · 由 Roitium 与贡献者构建</span>
				</div>
				<nav class="footer-links" aria-label="页脚导航">
					<a href="/guides/">指南</a>
					<a href="/SPL/">SPL 歌词规范</a>
					<a href={`${REPO}/issues`}>问题反馈</a>
					<a href={REPO}>GitHub</a>
				</nav>
			</div>
			<p class="container disclaimer dim">BBPlayer 是第三方开源项目，与哔哩哔哩没有关联。音视频内容版权归原作者所有。</p>
		</footer>

		<script src="../scripts/landing.ts"></script>
	</body>
</html>
